{
  "$defs": {
    "MigrationRepositoryBinding": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "title": "Commit Sha",
          "type": "string"
        },
        "ref": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "repository_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Repository Id",
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "ref",
        "commit_sha"
      ],
      "title": "MigrationRepositoryBinding",
      "type": "object"
    },
    "TaskStatus": {
      "enum": [
        "backlog",
        "ready",
        "active",
        "blocked",
        "needs_review",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "TaskStatus",
      "type": "string"
    }
  },
  "$id": "https://agora.local/schemas/v1/methodology-run-claim-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Explicit request to claim one formal first Run without process launch.",
  "properties": {
    "claim_formal_run": {
      "const": true,
      "default": true,
      "title": "Claim Formal Run",
      "type": "boolean"
    },
    "content_sha256": {
      "title": "Content Sha256",
      "type": "string"
    },
    "context_pack_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Context Pack Id",
      "type": "string"
    },
    "context_pack_schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Context Pack Schema Version",
      "type": "string"
    },
    "execution_contract_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Execution Contract Id",
      "type": "string"
    },
    "execution_contract_sha256": {
      "title": "Execution Contract Sha256",
      "type": "string"
    },
    "expected_control_task_status": {
      "$ref": "#/$defs/TaskStatus"
    },
    "expected_control_task_version": {
      "minimum": 1,
      "title": "Expected Control Task Version",
      "type": "integer"
    },
    "expected_plan_version": {
      "minimum": 1,
      "title": "Expected Plan Version",
      "type": "integer"
    },
    "expected_task_version": {
      "minimum": 1,
      "title": "Expected Task Version",
      "type": "integer"
    },
    "first_gate_key": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "First Gate Key",
      "type": "string"
    },
    "first_stage_key": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "First Stage Key",
      "type": "string"
    },
    "inventory_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Inventory Id",
      "type": "string"
    },
    "inventory_sha256": {
      "title": "Inventory Sha256",
      "type": "string"
    },
    "plan_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Plan Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "repository": {
      "$ref": "#/$defs/MigrationRepositoryBinding"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Request Id",
      "type": "string"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "route_activation_receipt_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Route Activation Receipt Id",
      "type": "string"
    },
    "route_activation_receipt_sha256": {
      "title": "Route Activation Receipt Sha256",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "runtime": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Runtime",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "start_runtime_process": {
      "const": false,
      "default": false,
      "title": "Start Runtime Process",
      "type": "boolean"
    },
    "task_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "content_sha256",
    "request_id",
    "requested_at",
    "project_id",
    "task_id",
    "expected_task_version",
    "expected_control_task_version",
    "expected_control_task_status",
    "plan_id",
    "expected_plan_version",
    "inventory_id",
    "inventory_sha256",
    "execution_contract_id",
    "execution_contract_sha256",
    "route_activation_receipt_id",
    "route_activation_receipt_sha256",
    "repository",
    "first_stage_key",
    "first_gate_key",
    "runtime",
    "run_id",
    "context_pack_id"
  ],
  "title": "MethodologyRunClaimRequest",
  "type": "object"
}
