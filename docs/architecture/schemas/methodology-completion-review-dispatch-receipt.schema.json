        "check": {
          "enum": [
            "route_binding",
            "observation_freshness",
            "observation_integrity",
            "runtime_command_binding",
            "runtime_installation",
            "capability_declaration_binding"
          ],
          "title": "Check",
          "type": "string"
        },
        "detail": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "satisfied": {
          "title": "Satisfied",
          "type": "boolean"
        }
      },
      "required": [
        "check",
        "satisfied",
        "detail"
      ],
      "title": "PinnedRuntimePreflightCheck",
      "type": "object"
    },
    "PinnedRuntimePreflightDecision": {
      "additionalProperties": false,
      "description": "Fresh native preflight for one pinned route without route substitution.",
