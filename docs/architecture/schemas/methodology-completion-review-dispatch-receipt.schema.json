          "title": "Route Selection Authority",
          "type": "boolean"
        },
        "runtime_capabilities": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
