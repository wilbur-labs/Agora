          "type": "string"
        },
        "satisfied": {
          "title": "Satisfied",
          "type": "boolean"
        }
      },
      "required": [
        "check",
        "satisfied",
        "detail"
      ],
      "title": "MethodologyCompletionReviewDispatchPolicyCheck",
      "type": "object"
    },
