    "MethodologyCompletionReviewDispatchPolicyCheck": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "enum": [
            "claimed_review_run",
            "completion_context",
            "current_final_stage",
            "repository_binding",
            "reviewer_independence",
            "runtime_binding",
            "usage_reservation"
