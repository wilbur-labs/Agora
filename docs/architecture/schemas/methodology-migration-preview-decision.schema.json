{
  "$defs": {
    "MethodologyMigrationPreviewCheck": {
      "additionalProperties": false,
      "properties": {
        "constraint": {
          "enum": [
            "task_binding",
            "current_methodology_binding",
            "repository_binding",
            "target_source_binding",
            "scope_selection",
            "scope_seed_artifacts",
            "runtime_pins",
            "budget",
            "human_gate",
            "task_quiescence"
          ],
          "title": "Constraint",
          "type": "string"
        },
        "detail": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "satisfied": {
          "title": "Satisfied",
          "type": "boolean"
        }
      },
      "required": [
        "constraint",
        "satisfied",
        "detail"
      ],
      "title": "MethodologyMigrationPreviewCheck",
      "type": "object"
    },
    "MigrationRepositoryBinding": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "title": "Commit Sha",
          "type": "string"
        },
        "ref": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "repository_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Repository Id",
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "ref",
        "commit_sha"
      ],
      "title": "MigrationRepositoryBinding",
      "type": "object"
    },
    "TaskStatus": {
      "enum": [
        "backlog",
        "ready",
        "active",
        "blocked",
        "needs_review",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "TaskStatus",
      "type": "string"
    }
  },
  "$id": "https://agora.local/schemas/v1/methodology-migration-preview-decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Non-authoritative result of one exact read-only migration preview.",
  "properties": {
    "active_consultations": {
      "minimum": 0,
      "title": "Active Consultations",
      "type": "integer"
    },
    "active_runs": {
      "minimum": 0,
      "title": "Active Runs",
      "type": "integer"
    },
    "blockers": {
      "items": {
        "enum": [
          "task_binding",
          "current_methodology_binding",
          "repository_binding",
          "target_source_binding",
          "scope_selection",
          "scope_seed_artifacts",
          "runtime_pins",
          "budget",
          "human_gate",
          "task_quiescence"
        ],
        "type": "string"
      },
      "maxItems": 10,
      "title": "Blockers",
      "type": "array"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/MethodologyMigrationPreviewCheck"
      },
      "maxItems": 10,
      "minItems": 10,
      "title": "Checks",
      "type": "array"
    },
    "content_sha256": {
      "title": "Content Sha256",
      "type": "string"
    },
    "current_methodology_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Current Methodology Id",
      "type": "string"
    },
    "current_methodology_sha256": {
      "title": "Current Methodology Sha256",
      "type": "string"
    },
    "current_methodology_version": {
      "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$",
      "title": "Current Methodology Version",
      "type": "string"
    },
    "decision_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Decision Id",
      "type": "string"
    },
    "dispatch_authority": {
      "const": false,
      "default": false,
      "title": "Dispatch Authority",
      "type": "boolean"
    },
    "eligible": {
      "title": "Eligible",
      "type": "boolean"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "inventory_mutated": {
      "const": false,
      "default": false,
      "title": "Inventory Mutated",
      "type": "boolean"
    },
    "migration_authority": {
      "const": false,
      "default": false,
      "title": "Migration Authority",
      "type": "boolean"
    },
    "migration_executed": {
      "const": false,
      "default": false,
      "title": "Migration Executed",
      "type": "boolean"
    },
    "migration_strategy": {
      "const": "successor_task",
      "default": "successor_task",
      "title": "Migration Strategy",
      "type": "string"
    },
    "observed_control_task_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed Control Task Version"
    },
    "observed_plan_version": {
      "minimum": 1,
      "title": "Observed Plan Version",
      "type": "integer"
    },
    "observed_repository": {
      "anyOf": [
        {
          "$ref": "#/$defs/MigrationRepositoryBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "observed_task_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "observed_task_version": {
      "minimum": 1,
      "title": "Observed Task Version",
      "type": "integer"
    },
    "plan_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Plan Id",
      "type": "string"
    },
    "plan_mutated": {
      "const": false,
      "default": false,
      "title": "Plan Mutated",
      "type": "boolean"
    },
    "preview_only": {
      "const": true,
      "default": true,
      "title": "Preview Only",
      "type": "boolean"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Request Id",
      "type": "string"
    },
    "request_sha256": {
      "title": "Request Sha256",
      "type": "string"
    },
    "routing_authority": {
      "const": false,
      "default": false,
      "title": "Routing Authority",
      "type": "boolean"
    },
    "runtime_spawned": {
      "const": false,
      "default": false,
      "title": "Runtime Spawned",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_scope": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Selected Scope",
      "type": "string"
    },
    "state_mutated": {
      "const": false,
      "default": false,
      "title": "State Mutated",
      "type": "boolean"
    },
    "target_activation_definition_sha256": {
      "title": "Target Activation Definition Sha256",
      "type": "string"
    },
    "target_activation_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Target Activation Id",
      "type": "string"
    },
    "target_methodology_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Target Methodology Id",
      "type": "string"
    },
    "target_methodology_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Target Methodology Version",
      "type": "string"
    },
    "target_source_graph_sha256": {
      "title": "Target Source Graph Sha256",
      "type": "string"
    },
    "task_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Task Id",
      "type": "string"
    },
    "unsettled_protocol_runs": {
      "minimum": 0,
      "title": "Unsettled Protocol Runs",
      "type": "integer"
    }
  },
  "required": [
    "content_sha256",
    "decision_id",
    "generated_at",
    "request_id",
    "request_sha256",
    "project_id",
    "task_id",
    "observed_task_version",
    "plan_id",
    "observed_plan_version",
    "current_methodology_id",
    "current_methodology_version",
    "current_methodology_sha256",
    "target_activation_id",
    "target_methodology_id",
    "target_methodology_version",
    "target_source_graph_sha256",
    "target_activation_definition_sha256",
    "selected_scope",
    "active_runs",
    "active_consultations",
    "unsettled_protocol_runs",
    "checks",
    "eligible"
  ],
  "title": "MethodologyMigrationPreviewDecision",
  "type": "object"
}
