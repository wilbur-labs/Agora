    },
    "source_task_version": {
      "minimum": 1,
      "title": "Source Task Version",
      "type": "integer"
    },
    "successor_control_task_status": {
      "$ref": "#/$defs/TaskStatus"
    },
    "successor_control_task_version": {
      "minimum": 1,
      "title": "Successor Control Task Version",
      "type": "integer"
    },
    "successor_inventory_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Successor Inventory Id",
      "type": "string"
    },
    "successor_inventory_sealed": {
      "const": true,
