      "title": "Successor Plan Id",
      "type": "string"
    },
    "successor_plan_sealed": {
      "const": true,
      "default": true,
      "title": "Successor Plan Sealed",
      "type": "boolean"
    },
    "successor_plan_version": {
      "const": 1,
      "default": 1,
      "title": "Successor Plan Version",
      "type": "integer"
    },
    "successor_task_created": {
      "const": true,
      "default": true,
      "title": "Successor Task Created",
      "type": "boolean"
    },
    "successor_task_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Successor Task Id",
      "type": "string"
