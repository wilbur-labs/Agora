{
  "$defs": {
    "ApprovalArtifactBinding": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "title": "Commit Sha",
          "type": "string"
        },
        "path": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "ref": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "repository_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Repository Id",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "ref",
        "commit_sha",
        "path",
        "sha256"
      ],
      "title": "ApprovalArtifactBinding",
      "type": "object"
    },
    "ArtifactLocation": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "title": "Commit Sha",
          "type": "string"
        },
        "path": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "ref": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "repository_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Repository Id",
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "ref",
        "commit_sha",
        "path"
      ],
      "title": "ArtifactLocation",
      "type": "object"
    },
    "ArtifactVersionRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Kind",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "version",
        "sha256",
        "kind"
      ],
      "title": "ArtifactVersionRef",
      "type": "object"
    },
    "MethodologyCompletionEvidenceApprovalBinding": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_sha256": {
          "title": "Evidence Sha256",
          "type": "string"
        },
        "producer_run_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Producer Run Id",
          "type": "string"
        },
        "requirement_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Requirement Id",
          "type": "string"
        },
        "status": {
          "const": "passed",
          "default": "passed",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "evidence_sha256",
        "requirement_id",
        "producer_run_id"
      ],
      "title": "MethodologyCompletionEvidenceApprovalBinding",
      "type": "object"
    },
    "MethodologyCompletionReviewApprovalBinding": {
      "additionalProperties": false,
      "properties": {
        "claim_receipt_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Claim Receipt Id",
          "type": "string"
        },
        "claim_receipt_sha256": {
          "title": "Claim Receipt Sha256",
          "type": "string"
        },
        "dispatch_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Dispatch Id",
          "type": "string"
        },
        "dispatch_receipt_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Dispatch Receipt Id",
          "type": "string"
        },
        "dispatch_receipt_sha256": {
          "title": "Dispatch Receipt Sha256",
          "type": "string"
        },
        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_sha256": {
          "title": "Evidence Sha256",
          "type": "string"
        },
        "handoff_pack_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Handoff Pack Id",
          "type": "string"
        },
        "handoff_pack_sha256": {
          "title": "Handoff Pack Sha256",
          "type": "string"
        },
        "responsibility": {
          "enum": [
            "independent_correctness",
            "methodology_stewardship"
          ],
          "title": "Responsibility",
          "type": "string"
        },
        "review_run_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Review Run Id",
          "type": "string"
        }
      },
      "required": [
        "responsibility",
        "claim_receipt_id",
        "claim_receipt_sha256",
        "dispatch_id",
        "dispatch_receipt_id",
        "dispatch_receipt_sha256",
        "review_run_id",
        "handoff_pack_id",
        "handoff_pack_sha256",
        "evidence_id",
        "evidence_sha256"
      ],
      "title": "MethodologyCompletionReviewApprovalBinding",
      "type": "object"
    },
    "MigrationRepositoryBinding": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "title": "Commit Sha",
          "type": "string"
        },
        "ref": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "repository_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Repository Id",
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "ref",
        "commit_sha"
      ],
      "title": "MigrationRepositoryBinding",
      "type": "object"
    }
  },
  "$id": "https://agora.local/schemas/v1/methodology-completion-approval-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One explicit human assertion over the final reviewed Task snapshot.",
  "properties": {
    "activation_definition_sha256": {
      "title": "Activation Definition Sha256",
      "type": "string"
    },
    "active_evidence": {
      "items": {
        "$ref": "#/$defs/MethodologyCompletionEvidenceApprovalBinding"
      },
      "maxItems": 210,
      "minItems": 1,
      "title": "Active Evidence",
      "type": "array"
    },
    "approval_artifacts": {
      "items": {
        "$ref": "#/$defs/ApprovalArtifactBinding"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Approval Artifacts",
      "type": "array"
    },
    "approval_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Approval Id",
      "type": "string"
    },
    "approval_reason": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Approval Reason",
      "type": "string"
    },
    "approved_at": {
      "format": "date-time",
      "title": "Approved At",
      "type": "string"
    },
    "approved_by": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Approved By",
      "type": "string"
    },
    "artifact_versions": {
      "items": {
        "$ref": "#/$defs/ArtifactVersionRef"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Artifact Versions",
      "type": "array"
    },
    "complete_task": {
      "const": true,
      "default": true,
      "title": "Complete Task",
      "type": "boolean"
    },
    "completion_reviews": {
      "items": {
        "$ref": "#/$defs/MethodologyCompletionReviewApprovalBinding"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Completion Reviews",
      "type": "array"
    },
    "content_sha256": {
      "title": "Content Sha256",
      "type": "string"
    },
    "evaluate_gate": {
      "const": false,
      "default": false,
      "title": "Evaluate Gate",
      "type": "boolean"
    },
    "execution_contract_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Execution Contract Id",
      "type": "string"
    },
    "execution_contract_sha256": {
      "title": "Execution Contract Sha256",
      "type": "string"
    },
    "expected_control_task_status": {
      "const": "needs_review",
      "default": "needs_review",
      "title": "Expected Control Task Status",
      "type": "string"
    },
    "expected_control_task_version": {
      "minimum": 1,
      "title": "Expected Control Task Version",
      "type": "integer"
    },
    "expected_gate_status": {
      "const": "passed",
      "default": "passed",
      "title": "Expected Gate Status",
      "type": "string"
    },
    "expected_gate_version": {
      "minimum": 1,
      "title": "Expected Gate Version",
      "type": "integer"
    },
    "expected_plan_version": {
      "minimum": 1,
      "title": "Expected Plan Version",
      "type": "integer"
    },
    "expected_stage_status": {
      "const": "completed",
      "default": "completed",
      "title": "Expected Stage Status",
      "type": "string"
    },
    "expected_stage_version": {
      "minimum": 1,
      "title": "Expected Stage Version",
      "type": "integer"
    },
    "expected_task_version": {
      "minimum": 1,
      "title": "Expected Task Version",
      "type": "integer"
    },
    "final_dispatch_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Final Dispatch Id",
      "type": "string"
    },
    "final_dispatch_receipt_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Final Dispatch Receipt Id",
      "type": "string"
    },
    "final_dispatch_receipt_sha256": {
      "title": "Final Dispatch Receipt Sha256",
      "type": "string"
    },
    "gate_key": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Gate Key",
      "type": "string"
    },
    "human_approved": {
      "const": true,
      "default": true,
      "title": "Human Approved",
      "type": "boolean"
    },
    "inventory_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Inventory Id",
      "type": "string"
    },
    "inventory_sha256": {
      "title": "Inventory Sha256",
      "type": "string"
    },
    "modify_stage": {
      "const": false,
      "default": false,
      "title": "Modify Stage",
      "type": "boolean"
    },
    "plan_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Plan Id",
      "type": "string"
    },
    "production_handoff_pack_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Production Handoff Pack Id",
      "type": "string"
    },
    "production_handoff_pack_sha256": {
      "title": "Production Handoff Pack Sha256",
      "type": "string"
    },
    "production_run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Production Run Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "register_artifact": {
      "const": false,
      "default": false,
      "title": "Register Artifact",
      "type": "boolean"
    },
    "register_evidence": {
      "const": false,
      "default": false,
      "title": "Register Evidence",
      "type": "boolean"
    },
    "repository": {
      "$ref": "#/$defs/MigrationRepositoryBinding"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Request Id",
      "type": "string"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_graph_sha256": {
      "title": "Source Graph Sha256",
      "type": "string"
    },
    "stage_key": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Stage Key",
      "type": "string"
    },
    "stage_sequence": {
      "maximum": 200,
      "minimum": 1,
      "title": "Stage Sequence",
      "type": "integer"
    },
    "start_runtime_process": {
      "const": false,
      "default": false,
      "title": "Start Runtime Process",
      "type": "boolean"
    },
    "task_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "content_sha256",
    "request_id",
    "requested_at",
    "approval_id",
    "approved_by",
    "approved_at",
    "approval_reason",
    "project_id",
    "task_id",
    "expected_task_version",
    "expected_control_task_version",
    "plan_id",
    "expected_plan_version",
    "inventory_id",
    "inventory_sha256",
    "execution_contract_id",
    "execution_contract_sha256",
    "repository",
    "source_graph_sha256",
    "activation_definition_sha256",
    "stage_sequence",
    "stage_key",
    "expected_stage_version",
    "gate_key",
    "expected_gate_version",
    "final_dispatch_id",
    "final_dispatch_receipt_id",
    "final_dispatch_receipt_sha256",
    "production_run_id",
    "production_handoff_pack_id",
    "production_handoff_pack_sha256",
    "completion_reviews",
    "artifact_versions",
    "approval_artifacts",
    "active_evidence"
  ],
  "title": "MethodologyCompletionApprovalRequest",
  "type": "object"
}
