        },
        "role": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Role",
          "type": "string"
        },
        "route_selection_authority": {
          "const": false,
