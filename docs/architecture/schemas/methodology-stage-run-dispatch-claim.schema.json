        },
        "runtime_command_sha256": {
          "title": "Runtime Command Sha256",
          "type": "string"
        },
        "runtime_registry_sha256": {
          "title": "Runtime Registry Sha256",
          "type": "string"
        },
        "runtime_substitution_allowed": {
          "const": false,
          "default": false,
          "title": "Runtime Substitution Allowed",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "stage_key": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Stage Key",
          "type": "string"
        },
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
