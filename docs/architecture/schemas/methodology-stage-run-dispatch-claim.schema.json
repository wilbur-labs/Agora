        "inventory_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Inventory Id",
          "type": "string"
        },
        "inventory_sha256": {
          "title": "Inventory Sha256",
          "type": "string"
        },
        "pinned_runtime": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Pinned Runtime",
          "type": "string"
        },
        "plan_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Plan Id",
          "type": "string"
        },
        "policy_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Policy Id",
          "type": "string"
        },
        "policy_sha256": {
          "title": "Policy Sha256",
          "type": "string"
        },
        "policy_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Policy Version",
          "type": "string"
        },
        "predecessor_dispatch_receipt_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Predecessor Dispatch Receipt Id",
          "type": "string"
        },
        "predecessor_dispatch_receipt_sha256": {
          "title": "Predecessor Dispatch Receipt Sha256",
          "type": "string"
        },
        "project_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Project Id",
          "type": "string"
        },
        "provider_serviceability_verified": {
          "const": false,
          "default": false,
          "title": "Provider Serviceability Verified",
          "type": "boolean"
        },
        "repository": {
          "$ref": "#/$defs/MigrationRepositoryBinding"
        },
        "result_format": {
          "enum": [
            "plain_text",
            "codex_jsonl_v1",
            "claude_json_v1",
            "kiro_chat_v1"
          ],
          "title": "Result Format",
          "type": "string"
        },
        "role": {
          "const": "production_execution",
          "default": "production_execution",
          "title": "Role",
          "type": "string"
        },
        "route_selection_authority": {
          "const": false,
          "default": false,
          "title": "Route Selection Authority",
          "type": "boolean"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Run Id",
          "type": "string"
        },
        "runtime_capabilities": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Runtime Capabilities",
          "type": "array"
        },
        "runtime_registry_sha256": {
          "title": "Runtime Registry Sha256",
          "type": "string"
        },
        "runtime_substitution_allowed": {
          "const": false,
          "default": false,
          "title": "Runtime Substitution Allowed",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "stage_gate_receipt_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Stage Gate Receipt Id",
          "type": "string"
        },
        "stage_gate_receipt_sha256": {
          "title": "Stage Gate Receipt Sha256",
          "type": "string"
        },
        "stage_key": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Stage Key",
          "type": "string"
        },
        "stage_run_claim_receipt_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Stage Run Claim Receipt Id",
          "type": "string"
        },
        "stage_run_claim_receipt_sha256": {
          "title": "Stage Run Claim Receipt Sha256",
          "type": "string"
        },
        "stage_sequence": {
          "maximum": 200,
          "minimum": 2,
          "title": "Stage Sequence",
          "type": "integer"
        },
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Task Id",
          "type": "string"
        },
        "token_reservation": {
          "minimum": 0,
          "title": "Token Reservation",
          "type": "integer"
        }
      },
      "required": [
        "content_sha256",
        "decision_id",
        "evaluated_at",
        "policy_id",
        "policy_sha256",
        "project_id",
        "task_id",
        "plan_id",
        "inventory_id",
        "inventory_sha256",
        "execution_contract_id",
        "execution_contract_sha256",
        "runtime_registry_sha256",
        "stage_gate_receipt_id",
        "stage_gate_receipt_sha256",
        "stage_run_claim_receipt_id",
        "stage_run_claim_receipt_sha256",
        "predecessor_dispatch_receipt_id",
        "predecessor_dispatch_receipt_sha256",
        "repository",
        "stage_sequence",
        "stage_key",
        "gate_key",
        "pinned_runtime",
        "result_format",
        "run_id",
        "context_pack_id",
        "context_pack_sha256",
        "runtime_capabilities",
        "token_reservation",
        "checks",
        "dispatchable"
      ],
      "title": "MethodologyStageRunDispatchPolicyDecision",
      "type": "object"
    },
    "MigrationRepositoryBinding": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "title": "Commit Sha",
          "type": "string"
        },
        "ref": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "repository_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Repository Id",
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "ref",
        "commit_sha"
      ],
      "title": "MigrationRepositoryBinding",
      "type": "object"
    },
    "NativeRuntimeCapabilityObservation": {
      "additionalProperties": false,
      "description": "Read-only local installation and declaration facts for native adapters.",
      "properties": {
        "adapters": {
          "items": {
            "$ref": "#/$defs/RuntimeCapabilityAdapterObservation"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Adapters",
          "type": "array"
        },
        "capability_declaration_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Capability Declaration Id",
          "type": "string"
        },
        "capability_declaration_sha256": {
          "title": "Capability Declaration Sha256",
          "type": "string"
        },
        "capability_declaration_version": {
          "pattern": "^\\d+\\.\\d+$",
          "title": "Capability Declaration Version",
          "type": "string"
        },
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "collector_id": {
          "const": "agora-native-runtime-capability-observer",
          "default": "agora-native-runtime-capability-observer",
          "title": "Collector Id",
          "type": "string"
        },
        "collector_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Collector Version",
          "type": "string"
        },
        "content_sha256": {
          "title": "Content Sha256",
          "type": "string"
        },
        "platform": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Platform",
          "type": "string"
        },
        "routing_authority": {
          "const": false,
          "default": false,
          "title": "Routing Authority",
          "type": "boolean"
        },
        "runtime_registry_sha256": {
          "title": "Runtime Registry Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "content_sha256",
        "collected_at",
        "platform",
        "runtime_registry_sha256",
        "capability_declaration_id",
        "capability_declaration_version",
        "capability_declaration_sha256",
        "adapters"
      ],
      "title": "NativeRuntimeCapabilityObservation",
      "type": "object"
    },
    "PinnedRuntimePreflightCheck": {
      "additionalProperties": false,
      "description": "One deterministic allow/block check for an already selected runtime.",
      "properties": {
        "check": {
          "enum": [
            "route_binding",
            "observation_freshness",
            "observation_integrity",
            "runtime_command_binding",
            "runtime_installation",
            "capability_declaration_binding"
          ],
          "title": "Check",
          "type": "string"
        },
        "detail": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "satisfied": {
          "title": "Satisfied",
          "type": "boolean"
        }
      },
      "required": [
        "check",
        "satisfied",
        "detail"
      ],
      "title": "PinnedRuntimePreflightCheck",
      "type": "object"
    },
