        "content_sha256",
        "decision_id",
        "evaluated_at",
        "valid_until",
        "task_id",
        "project_id",
        "run_id",
        "inventory_id",
        "inventory_sha256",
        "stage_key",
        "role",
        "pinned_runtime",
        "routing_policy_decision_id",
