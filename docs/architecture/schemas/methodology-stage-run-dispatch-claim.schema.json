        "declared_models": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Declared Models",
          "type": "array"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "installation_status": {
          "enum": [
            "installed",
            "not_found",
            "uninspectable"
          ],
          "title": "Installation Status",
          "type": "string"
        },
        "inventory_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Inventory Id",
          "type": "string"
        },
        "inventory_sha256": {
          "title": "Inventory Sha256",
          "type": "string"
        },
        "max_observation_age_seconds": {
          "const": 60,
          "default": 60,
          "title": "Max Observation Age Seconds",
          "type": "integer"
        },
        "model_availability": {
          "enum": [
            "declared",
            "unavailable"
          ],
          "title": "Model Availability",
          "type": "string"
        },
        "observation_collected_at": {
