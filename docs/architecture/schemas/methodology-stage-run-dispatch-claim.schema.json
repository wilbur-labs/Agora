{
  "$defs": {
    "MethodologyStageRunDispatchPolicyCheck": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "enum": [
            "claimed_formal_run",
            "context_binding",
            "current_route",
            "repository_binding",
            "runtime_binding",
            "usage_reservation"
          ],
          "title": "Check",
          "type": "string"
        },
        "detail": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "satisfied": {
          "title": "Satisfied",
          "type": "boolean"
        }
      },
      "required": [
        "check",
        "satisfied",
        "detail"
      ],
      "title": "MethodologyStageRunDispatchPolicyCheck",
      "type": "object"
    },
    "MethodologyStageRunDispatchPolicyDecision": {
      "additionalProperties": false,
      "description": "Per-Run allow/block policy for one already claimed later Stage.",
      "properties": {
        "blockers": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 6,
          "title": "Blockers",
          "type": "array"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/MethodologyStageRunDispatchPolicyCheck"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Checks",
          "type": "array"
        },
        "content_sha256": {
          "title": "Content Sha256",
          "type": "string"
        },
        "context_pack_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Context Pack Id",
          "type": "string"
        },
        "context_pack_sha256": {
          "title": "Context Pack Sha256",
          "type": "string"
        },
        "cost_reservation_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Reservation Usd"
        },
        "decision_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Decision Id",
          "type": "string"
        },
        "dispatchable": {
          "title": "Dispatchable",
          "type": "boolean"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "execution_contract_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Execution Contract Id",
          "type": "string"
        },
        "execution_contract_sha256": {
          "title": "Execution Contract Sha256",
          "type": "string"
        },
        "gate_key": {
          "maxLength": 128,
          "minLength": 1,
