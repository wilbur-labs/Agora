          "type": "boolean"
        },
        "routing_policy_decision_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Routing Policy Decision Id",
          "type": "string"
        },
        "routing_policy_decision_sha256": {
          "title": "Routing Policy Decision Sha256",
          "type": "string"
        },
        "routing_policy_declaration_sha256": {
          "title": "Routing Policy Declaration Sha256",
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
