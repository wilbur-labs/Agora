{
  "$defs": {
    "ArtifactLocation": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "title": "Commit Sha",
          "type": "string"
        },
        "path": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "ref": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "repository_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Repository Id",
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "ref",
        "commit_sha",
        "path"
      ],
      "title": "ArtifactLocation",
      "type": "object"
    },
    "ArtifactVersionRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Kind",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "version",
        "sha256",
        "kind"
      ],
      "title": "ArtifactVersionRef",
      "type": "object"
    },
    "GateRequirement": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "title": "Commit Sha",
          "type": "string"
        },
        "evidence_kind": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Evidence Kind",
          "type": "string"
        },
        "failure_action": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Failure Action",
          "type": "string"
        },
        "priority": {
          "default": 100,
          "maximum": 10000,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "ref": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "repository_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Repository Id",
          "type": "string"
        },
        "requirement_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Requirement Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "pattern": "^1\\.[0-9]+$",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/RequirementSeverity",
          "default": "blocker"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "title",
        "repository_id",
        "ref",
        "commit_sha",
        "evidence_kind",
        "failure_action"
      ],
      "title": "GateRequirement",
      "type": "object"
    },
    "MigrationRepositoryBinding": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "title": "Commit Sha",
          "type": "string"
        },
        "ref": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "repository_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Repository Id",
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "ref",
        "commit_sha"
      ],
      "title": "MigrationRepositoryBinding",
      "type": "object"
    },
    "RequirementSeverity": {
      "enum": [
        "blocker",
        "warning"
      ],
      "title": "RequirementSeverity",
      "type": "string"
    }
  },
  "$id": "https://agora.local/schemas/v1/methodology-completion-review-claim-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable claim binding one reviewer Run to final production facts.",
  "properties": {
    "active_evidence_ids_after": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Active Evidence Ids After",
      "type": "array"
    },
    "active_evidence_ids_before": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Active Evidence Ids Before",
      "type": "array"
    },
    "artifact_versions": {
      "items": {
        "$ref": "#/$defs/ArtifactVersionRef"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Artifact Versions",
      "type": "array"
    },
    "authenticated_permission": {
      "const": "control_plane.approve",
      "default": "control_plane.approve",
      "title": "Authenticated Permission",
      "type": "string"
    },
    "authenticated_principal_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Authenticated Principal Id",
      "type": "string"
    },
    "budget_admission_passed": {
      "const": true,
      "default": true,
      "title": "Budget Admission Passed",
      "type": "boolean"
    },
    "claim_persisted": {
      "const": true,
      "default": true,
      "title": "Claim Persisted",
      "type": "boolean"
    },
    "claimed_at": {
      "format": "date-time",
      "title": "Claimed At",
      "type": "string"
    },
    "completion_review_protected_cost_usd": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completion Review Protected Cost Usd"
    },
    "completion_review_protected_tokens": {
      "maximum": 20000000,
      "minimum": 1,
      "title": "Completion Review Protected Tokens",
      "type": "integer"
    },
    "content_sha256": {
      "title": "Content Sha256",
      "type": "string"
    },
    "control_task_mutated": {
      "const": false,
      "default": false,
      "title": "Control Task Mutated",
      "type": "boolean"
    },
    "control_task_status_after": {
      "const": "blocked",
      "default": "blocked",
      "title": "Control Task Status After",
      "type": "string"
    },
    "control_task_status_before": {
      "const": "blocked",
      "default": "blocked",
      "title": "Control Task Status Before",
      "type": "string"
    },
    "control_task_version_after": {
      "minimum": 1,
      "title": "Control Task Version After",
      "type": "integer"
    },
    "control_task_version_before": {
      "minimum": 1,
      "title": "Control Task Version Before",
      "type": "integer"
    },
    "cost_reservation_usd": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Reservation Usd"
    },
    "execution_contract_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Execution Contract Id",
      "type": "string"
    },
    "execution_contract_sha256": {
      "title": "Execution Contract Sha256",
      "type": "string"
    },
    "final_dispatch_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Final Dispatch Id",
      "type": "string"
    },
    "final_dispatch_receipt_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Final Dispatch Receipt Id",
      "type": "string"
    },
    "final_dispatch_receipt_sha256": {
      "title": "Final Dispatch Receipt Sha256",
      "type": "string"
    },
    "gate_key": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Gate Key",
      "type": "string"
    },
    "gate_mutated": {
      "const": false,
      "default": false,
      "title": "Gate Mutated",
      "type": "boolean"
    },
    "gate_status_after": {
      "const": "blocked",
      "default": "blocked",
      "title": "Gate Status After",
      "type": "string"
    },
    "gate_status_before": {
      "const": "blocked",
      "default": "blocked",
      "title": "Gate Status Before",
      "type": "string"
    },
    "gate_version_after": {
      "minimum": 1,
      "title": "Gate Version After",
      "type": "integer"
    },
    "gate_version_before": {
      "minimum": 1,
      "title": "Gate Version Before",
      "type": "integer"
    },
    "inventory_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Inventory Id",
      "type": "string"
    },
    "inventory_sha256": {
      "title": "Inventory Sha256",
      "type": "string"
    },
    "plan_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Plan Id",
      "type": "string"
    },
    "plan_mutated": {
      "const": false,
      "default": false,
      "title": "Plan Mutated",
      "type": "boolean"
    },
    "plan_version_after": {
      "minimum": 1,
      "title": "Plan Version After",
      "type": "integer"
    },
    "plan_version_before": {
      "minimum": 1,
      "title": "Plan Version Before",
      "type": "integer"
    },
    "process_spawn_authority": {
      "const": false,
      "default": false,
      "title": "Process Spawn Authority",
      "type": "boolean"
    },
    "process_started": {
      "const": false,
      "default": false,
      "title": "Process Started",
      "type": "boolean"
    },
    "production_handoff_pack_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Production Handoff Pack Id",
      "type": "string"
    },
    "production_handoff_pack_sha256": {
      "title": "Production Handoff Pack Sha256",
      "type": "string"
    },
    "production_run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Production Run Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "protocol_artifacts_created": {
      "const": false,
      "default": false,
      "title": "Protocol Artifacts Created",
      "type": "boolean"
    },
    "protocol_evidence_created": {
      "const": false,
      "default": false,
      "title": "Protocol Evidence Created",
      "type": "boolean"
    },
    "provider_active_cost_usd_before": {
      "minimum": 0,
      "title": "Provider Active Cost Usd Before",
      "type": "number"
    },
    "provider_active_tokens_before": {
      "minimum": 0,
      "title": "Provider Active Tokens Before",
      "type": "integer"
    },
    "provider_settled_cost_usd_before": {
      "minimum": 0,
      "title": "Provider Settled Cost Usd Before",
      "type": "number"
    },
    "provider_settled_tokens_before": {
      "minimum": 0,
      "title": "Provider Settled Tokens Before",
      "type": "integer"
    },
    "provider_substitution": {
      "const": false,
      "default": false,
      "title": "Provider Substitution",
      "type": "boolean"
    },
    "receipt_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Receipt Id",
      "type": "string"
    },
    "repository": {
      "$ref": "#/$defs/MigrationRepositoryBinding"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Request Id",
      "type": "string"
    },
    "request_sha256": {
      "title": "Request Sha256",
      "type": "string"
    },
    "requirement": {
      "$ref": "#/$defs/GateRequirement"
    },
    "responsibility": {
      "enum": [
        "independent_correctness",
        "methodology_stewardship"
      ],
      "title": "Responsibility",
      "type": "string"
    },
    "review_run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Review Run Id",
      "type": "string"
    },
    "runtime": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Runtime",
      "type": "string"
    },
    "runtime_command_sha256": {
      "title": "Runtime Command Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stage_key": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Stage Key",
      "type": "string"
    },
    "stage_mutated": {
      "const": false,
      "default": false,
      "title": "Stage Mutated",
      "type": "boolean"
    },
    "stage_sequence": {
      "maximum": 200,
      "minimum": 1,
      "title": "Stage Sequence",
      "type": "integer"
    },
    "stage_status_after": {
      "const": "blocked",
      "default": "blocked",
      "title": "Stage Status After",
      "type": "string"
    },
    "stage_status_before": {
      "const": "blocked",
      "default": "blocked",
      "title": "Stage Status Before",
      "type": "string"
    },
    "stage_version_after": {
      "minimum": 1,
      "title": "Stage Version After",
      "type": "integer"
    },
    "stage_version_before": {
      "minimum": 1,
      "title": "Stage Version Before",
      "type": "integer"
    },
    "task_cost_budget_usd": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Cost Budget Usd"
    },
    "task_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Task Id",
      "type": "string"
    },
    "task_mutated": {
      "const": false,
      "default": false,
      "title": "Task Mutated",
      "type": "boolean"
    },
    "task_token_budget": {
      "maximum": 10000000,
      "minimum": 1,
      "title": "Task Token Budget",
      "type": "integer"
    },
    "task_version_after": {
      "minimum": 1,
      "title": "Task Version After",
      "type": "integer"
    },
    "task_version_before": {
      "minimum": 1,
      "title": "Task Version Before",
      "type": "integer"
    },
    "token_reservation": {
      "maximum": 10000000,
      "minimum": 1,
      "title": "Token Reservation",
      "type": "integer"
    }
  },
  "required": [
    "content_sha256",
    "receipt_id",
    "claimed_at",
    "request_id",
    "request_sha256",
    "authenticated_principal_id",
    "project_id",
    "task_id",
    "task_version_before",
    "task_version_after",
    "control_task_version_before",
    "control_task_version_after",
    "plan_id",
    "plan_version_before",
    "plan_version_after",
    "inventory_id",
    "inventory_sha256",
    "execution_contract_id",
    "execution_contract_sha256",
    "final_dispatch_id",
    "final_dispatch_receipt_id",
    "final_dispatch_receipt_sha256",
    "production_run_id",
    "production_handoff_pack_id",
    "production_handoff_pack_sha256",
    "repository",
    "stage_sequence",
    "stage_key",
    "gate_key",
    "stage_version_before",
    "stage_version_after",
    "gate_version_before",
    "gate_version_after",
    "active_evidence_ids_before",
    "active_evidence_ids_after",
    "responsibility",
    "runtime",
    "runtime_command_sha256",
    "review_run_id",
    "requirement",
    "artifact_versions",
    "token_reservation",
    "task_token_budget",
    "provider_settled_tokens_before",
    "provider_settled_cost_usd_before",
    "provider_active_tokens_before",
    "provider_active_cost_usd_before",
    "completion_review_protected_tokens"
  ],
  "title": "MethodologyCompletionReviewClaimReceipt",
  "type": "object"
}
