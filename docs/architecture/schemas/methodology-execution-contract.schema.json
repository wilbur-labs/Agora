          "maxItems": 9,
          "minItems": 9,
          "title": "Binding Fields",
          "type": "array"
        },
        "completion_human_approval_required": {
          "const": true,
          "default": true,
          "title": "Completion Human Approval Required",
          "type": "boolean"
        },
        "migration_human_approval_required": {
          "const": true,
          "default": true,
          "title": "Migration Human Approval Required",
          "type": "boolean"
        }
      },
      "required": [
        "binding_fields"
      ],
      "title": "ActivationApprovalPolicy",
      "type": "object"
    },
    "ActivationRoleProfile": {
