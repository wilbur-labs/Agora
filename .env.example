# Agora Environment Variables
# Copy this file to .env and configure only the capabilities you use.
#
# The Agora 1.0 Task control plane launches the native Codex, Claude Code, and
# Kiro CLIs through explicit Stage routes. It does not run the retired 0.5
# multi-agent discussion council. The direct-provider variables below remain
# only for inert 0.5 configuration/data compatibility during source cleanup;
# they are not required by `agora task`.

# === Recommended setup ===

# Required to open the authenticated Task Control Plane. Generate a private,
# high-entropy value and enter the same value in the browser connection form.
AGORA_CONTROL_PLANE_TOKEN=

# Optional explicit config file, useful for isolated acceptance or multiple
# local Agora instances. A direct get_config(path) argument still takes
# precedence.
# AGORA_CONFIG_PATH=D:\path\to\isolated-config.yaml

# Legacy direct Anthropic provider (not used by the Task control plane).
CLAUDE_API_KEY=

# Legacy direct Azure OpenAI provider (not used for autonomous discussion).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=https://your-resource.openai.azure.com

# === Alternatives (edit config.yaml to switch) ===

# OpenAI direct (if you don't have Azure access)
# OPENAI_API_KEY=sk-...

# DeepSeek (OpenAI-compatible, low cost)
# DEEPSEEK_API_KEY=

# Kiro CLI (headless mode, requires kiro-cli installed)
# KIRO_API_KEY=ksk_...

# === Optional ===

# Optional embedding provider used by the current embedding store only when
# explicitly configured.

# Web search (future)
# TAVILY_API_KEY=
